// Copy to secrets.h in this folder and fill in. secrets.h is git-ignored.
// ESP32 only: with this file the rover joins Wi-Fi and the farm broker; without it, USB only.
#define WIFI_SSID      "your-wifi"        // 2.4 GHz: the ESP32 has no 5 GHz radio
#define WIFI_PASSWORD  "your-password"
#define MQTT_HOST      "192.168.1.50"     // the farm server's LAN address
#define MQTT_PORT      1883
#define MQTT_USER      "aaf"
#define MQTT_PASSWORD  "change-me"
#define MQTT_DRIVE     0                  // 1 = the farm server may drive over Wi-Fi (build step 2)
#define OTA_PASSWORD   "change-me"        // firmware over Wi-Fi; leave out to turn it off
