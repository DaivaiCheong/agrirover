# ============================================================
# AGRIROVER — environment template
# Copy to .env and adjust. .env is git-ignored; never commit it.
# ============================================================

# --- NoSQL database (MongoDB 7 in Docker) ---
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=agrirover

# --- security ---
# generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- mqtt (mosquitto runs alongside the API) ---
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_USERNAME=aaf
MQTT_PASSWORD=change-me
MQTT_TLS=false

# --- first administrator ---
ADMIN_EMAIL=admin@agrirover.local
ADMIN_PASSWORD=change-me

# --- photo check (optional local Ollama) ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4
OLLAMA_API_KEY=
PHOTO_MATCHES=false

# --- rover ---
ROVER_DEVICE_CODE=ROVER-01
ROVER_FARM_ID=farm-01
ROVER_SERIAL_PORT=/dev/ttyUSB0
ROVER_REPORT_DIR=reports

# --- frontend ---
VITE_API_BASE=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulated field node (docker compose --profile sim): dry | wet | rain
SIM_SCENARIO=dry

# --- farm identity ---
FARM_NAME=farm-01

# --- daily Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_MESSAGE_TIME=06:05
