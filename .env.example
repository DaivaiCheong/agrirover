# ============================================================
# AGRIROVER / AI AUTO FARM — environment template
# Copy to .env and fill in.  .env is git-ignored; never commit it.
# ============================================================

# --- database ---
POSTGRES_USER=aaf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aiautofarm
DATABASE_URL=postgresql+asyncpg://aaf:change-me@db:5432/aiautofarm

# --- security ---
# generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- mqtt (mosquitto runs on the Pi alongside the API) ---
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_USERNAME=aaf
MQTT_PASSWORD=change-me
MQTT_TLS=false

# --- first administrator (not used yet; login arrives with auth in S9) ---
ADMIN_EMAIL=admin@aiautofarm.local
ADMIN_PASSWORD=change-me

# --- optional: rainfall forecast, used only to defer irrigation ---
WEATHER_API_URL=
WEATHER_API_KEY=

# --- photo check: a local Ollama (`ollama pull gemma4`). No key: photos stay on this machine ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4
# To use the hosted service instead (photos then leave the farm, and the free tier has limits):
#   OLLAMA_URL=https://ollama.com   OLLAMA_MODEL=gemma4:31b   OLLAMA_API_KEY=your-key   PHOTO_MATCHES=true
OLLAMA_API_KEY=
PHOTO_MATCHES=false

# --- rover (on the rover's own Raspberry Pi) ---
ROVER_DEVICE_CODE=ROVER-01
ROVER_FARM_ID=farm-01
ROVER_SERIAL_PORT=/dev/ttyUSB0
ROVER_REPORT_DIR=reports

# --- frontend ---
VITE_API_BASE=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulated field node (docker compose --profile sim): dry | wet | rain
SIM_SCENARIO=dry

# --- Stage 1 farm: the topic segment farm/{FARM_NAME}/... must match ---
FARM_NAME=farm-01

# --- daily Telegram message with Approve / Skip (leave empty to keep it off) ---
# Create a bot with @BotFather; your chat id: message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates. Only this chat can approve.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_MESSAGE_TIME=06:05
