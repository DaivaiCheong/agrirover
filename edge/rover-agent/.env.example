# The rover's own settings, on its Raspberry Pi. Copy to .env in edge/rover-agent; `python -m rover ...` reads it.
# Variables already set in the shell win over this file.

# The PC (or Pi) running the farm server: its address on the same Wi-Fi.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883

# The motor controller: an ESP8266 NodeMCU usually shows as /dev/ttyUSB0, an Arduino Uno or Nano as /dev/ttyACM0 or /dev/ttyUSB0.
ROVER_SERIAL_PORT=/dev/ttyUSB0

# Calibration, measured on the floor with `python -m rover jog forward 0.5` and `python -m rover jog turn 90`.
ROVER_PWM_CRUISE=150
ROVER_MPS_AT_CRUISE=0.20
ROVER_DPS_AT_CRUISE=45

# The battery stop: 11.1 for a 3S pack, 6.6 for a 2S pack. 0 turns it off: only when no battery divider is wired.
ROVER_BATTERY_MIN_V=11.1

ROVER_REPORT_DIR=reports
